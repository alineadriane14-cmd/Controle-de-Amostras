rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Só quem abriu o site (login anônimo automático) pode ler e gravar
    match /medicamentos/{id} {
      allow read, write: if request.auth != null;
    }
    match /retiradas/{id} {
      allow read, create: if request.auth != null;
      allow update, delete: if false; // histórico não pode ser apagado pelo site
    }
  }
}
